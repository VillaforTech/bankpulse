      "targets": [{"refId": "A", "expr": "up{job=\"business-analytics\"}"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "id": 11,
      "title": "Historial de revisiones confirmadas",
